# Server
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limits
# GLOBAL_RATE_LIMIT_MAX=100
# LOGIN_RATE_LIMIT_MAX=5
# VERIFY_RATE_LIMIT_MAX=5

# Login lockout (trava a conta apos tentativas falhas)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15

# Database
DATABASE_PATH=./data/database.sqlite
# DATA_DIR=./data
# BACKUP_DIR=./data/backups
# UPLOADS_DIR=./data/uploads

# App
APP_URL=http://localhost:5173

# VAPID (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@transportesandreluis.com.br

# Email (verificação, forgot password, notificações) via Resend
# Deixe vazio para desativar o envio (códigos aparecem como demoCode na UI).
# EMAIL_DISABLED=true força o modo demonstração mesmo com a API configurada (para testes/gravação de vídeo).
RESEND_API_KEY=
RESEND_FROM=Transporte André Luis <onboarding@resend.dev>
EMAIL_DISABLED=false

# WhatsApp via Evolution API (opcional - sem isso, envio em modo silencioso)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Mercado Pago (PIX e cartão via link de pagamento)
# Access Token de produção: developers.mercadopago.com.br > App > Credenciais de produção
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_API_URL=https://api.mercadopago.com (sandbox: https://api.mercadopago.com/sandbox)
# Webhook (opcional, elimina a dependência do polling):
#   Mercado Pago > App > Webhooks > POST https://SEU-DOMINIO/api/payments/webhook (evento "payment")

# Expiração do PIX (horas até uma cobrança pendente ser marcada como 'expired')
# MP_PIX_EXPIRY_HOURS=24

# Backup off-site (S3 ou R2/qualquer storage compatível)
# Enviado automaticamente a cada backup (cron diário 02:00 BRT + backup manual).
# Sem estas variáveis, os backups ficam apenas em BACKUP_DIR.
# S3_BUCKET=andre-luis-backups
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=backups
# MAX_BACKUPS=30
