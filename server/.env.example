# Server
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_PATH=./data/database.sqlite

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# VAPID (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@transportesandreluis.com.br

# Email (verificação, forgot password, notificações)
# Deixe vazio para desativar o envio (códigos aparecem como demoCode na UI).
# EMAIL_DISABLED=true força o modo demonstração mesmo com a API configurada (para testes/gravação de vídeo).
RESEND_API_KEY=
RESEND_FROM=Transporte André Luis <onboarding@resend.dev>
EMAIL_DISABLED=false

# Asaas (PIX e cartão via link de pagamento)
ASAAS_API_KEY=aact_...
# ASAAS_API_URL=https://www.asaas.com/api/v3 (sandbox: https://sandbox.asaas.com/api/v3)

# Data (persistencia em volume no Railway)
DATA_DIR=./data
BACKUP_DIR=./data/backups
