# ============================================
# TRANSPORTE ANDRÉ LUIS — Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
# ============================================

# --- GERAL ---
VITE_APP_ENV=development
VITE_APP_NAME="Transporte André Luis"
VITE_APP_VERSION=1.0.0

# --- MODO DE API ---
# true = usa o backend real (Express + SQLite em http://localhost:3001)
# false = usa dados mock (localStorage, sem backend)
VITE_REAL_API=false

# --- REDE ---
VITE_API_URL=http://localhost:3001/api
VITE_PORT=5173

# --- SEGURANÇA ---
VITE_SESSION_TIMEOUT=1800000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOGIN_BLOCK_DURATION=900000
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# --- PERFORMANCE ---
VITE_PAGE_SIZE=15
VITE_MAX_PAGE_SIZE=100
VITE_CACHE_TTL=300000
VITE_CACHE_PREFIX=app_cache_

# --- LOGS ---
VITE_LOG_LEVEL=info

# --- MONITORAMENTO ---
VITE_MONITORING_ENABLED=false
VITE_MONITORING_INTERVAL=30000

# --- BACKUP ---
VITE_BACKUP_RETENTION_DAYS=30
VITE_MAX_BACKUPS=10

# --- COMUNICAÇÃO (WhatsApp) ---
# Twilio para WhatsApp (opcional - sem isso, usa modo mock)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_NUMBER=+14155238886

# --- PUSH NOTIFICATION ---
# Gerar VAPID keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:contato@exemplo.com
